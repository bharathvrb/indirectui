    "angular": "^1.8.3",
    "angular-route": "^1.8.3",
    "angular-sanitize": "^1.8.3",
    "angular-animate": "^1.8.3",
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "~1.11.3",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "angular-mocks": "^1.8.3",
    "http-server": "^14.1.1",
    "karma": "^6.4.2",
    "karma-jasmine": "^5.1.0",
    "karma-chrome-launcher": "^3.2.0",
    "jasmine-core": "^5.1.1",
    "gulp": "^4.0.2"
  }
