{
  "name": "quote-management-frontend",
  "version": "1.0.0",
  "description": "AngularJS workspace for OMW indirect quote requests, served by a Node proxy to QuoteData",
  "main": "src/app/app.js",
  "scripts": {
    "prestart": "npm run build",
    "start": "node server.js",
    "test": "karma start karma.conf.js",
