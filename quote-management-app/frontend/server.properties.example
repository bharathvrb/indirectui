# Local server settings for the QuoteData workspace (loaded by `npm start`).
# Copy this file to server.properties and fill in the <...> values. server.properties is git-ignored
# so the secret never reaches git. Real environment variables override these values.

# QuoteData service account (OAuth client_credentials), from the requirement document.
QUOTEDATA_CLIENT_ID=orion_dev
QUOTEDATA_CLIENT_SECRET=<client_secret from the requirement document>
QUOTEDATA_SCOPE=orion:orion-dev
QUOTEDATA_TOKEN_URL=https://sat-ci.codebig2.net/v2/ws/token.oauth2
QUOTEDATA_BASE_URL=https://quotedata-flx.as-g8.cf.comcast.net/quotedata/v1
# If the QuoteData host only serves plain HTTP, switch the URL above to http:// and uncomment:
# QUOTEDATA_ALLOW_HTTP=true

# SSO sign-in verification. Must match AUTH_CONFIG.clientId / tenantId in src/config.js.
SSO_CLIENT_ID=ae57677b-0389-4a92-bbf5-078156e0886b
SSO_TENANT_ID=906aefe9-76a7-4f65-b82d-5ec20775d5aa

# Local development login (disabled when NODE_ENV=production). Change these as needed.
LOCAL_LOGIN_USERNAME=bharath
LOCAL_LOGIN_PASSWORD=<choose a password>
